# One key, automatic selection across five Gemini models.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: override the automatic pool. Legacy GEMINI_MODEL/GEMINI_MODELS are ignored.
# GEMINI_ROUTER_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-pro-preview,gemini-3.7-flash,gemini-3.6-flash
# Optional alternative provider (one configured OpenAI model).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# DATA_DIR=./data

# Private workspace settings. Keep local binding unless HTTPS is configured.
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# APP_ORIGIN=https://your-domain.example
# Relevance threshold is a tunable raw cross-encoder logit, NOT a probability.
MIN_RERANK_SCORE=0
OCR_LANG=eng
# Windows example (install Tesseract separately for scanned files):
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Optional Unicode font for PDF exports:
# EXPORT_FONT=C:/Windows/Fonts/arial.ttf
